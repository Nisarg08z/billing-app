# MongoDB connection string (from MongoDB Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/
# Database name inside the cluster
MONGODB_DB=bapa_sitaram
# Password staff type to sign in on a phone
APP_PASSWORD=choose-a-password
# Long random string used to sign the login cookie (any 32+ characters)
AUTH_SECRET=replace-with-a-long-random-string
